<launch>
  <node pkg="laser_filters" type="scan_to_scan_filter_chain" output="screen" name="laser_filter">
    <rosparam command="load" file="$(find p450_experiment)/config/filter_lidar.yaml"/>
    <remap from="/scan" to="/uav1/scan"/>
    <remap from="/scan_filtered" to="/uav1/scan_filtered"/>
  </node>
</launch>
