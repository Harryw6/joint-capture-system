<launch>
    <arg name="uav_id" default="1"/>
    <!-- 启动 radius_filter 节点 -->
    <node pkg="p450_mission" type="radius_filter" name="radius_filter_node" output="screen">
        <remap from="cloud_in" to="/uav$(arg uav_id)/octomap_point_cloud_centers_original" />
        <remap from="filter_cloud_out" to="/uav$(arg uav_id)/octomap_point_cloud_centers" />
        <!-- 参数设置 -->
        <param name="uav_id" type="int" value="$(arg uav_id)" />
        <param name="outrem_radius" type="double" value="0.3" />
        <param name="outrem_neighbors" type="int"  value="10" />
    </node>
</launch>

