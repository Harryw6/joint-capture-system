<launch>
    <node pkg="spirecv_ros" type="aruco_detection_with_d435i" name="aruco_detection_with_d435i" output="screen">
        <param name="uav_id" type="int" value="1" />
        <param name="camera_parameters" type="string" value="$(find p450_experiment)/config/spirecv_config/calib_webcam_640x480.yaml" />
        <param name="local_saving_path" type="string" value="$(find spirecv_ros)" />
	<param name="input_image_topic" type="string" value="/uav1/camera/color/image_raw" />
	<param name="output_image_topic" type="string" value="/uav1/spirecv/image_det" />
    </node>
</launch>
