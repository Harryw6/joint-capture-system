<launch>
    <arg name="uav_id" default="1"/>
    <node pkg="spirecv_ros" type="video_streaming" name="video_streaming" output="screen">
        <param name="input_original_image_topic" type="string" value="/uav$(arg uav_id)/camera/color/image_raw" />
        <param name="input_process_image_topic" type="string" value="/uav1/spirecv/image_det" />
        <param name="mode" type="int" value="0" />
        <param name="video_streamer_width" type="int" value="640" />
        <param name="video_streamer_height" type="int" value="480" />
    </node>
</launch>

